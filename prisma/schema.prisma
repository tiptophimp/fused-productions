generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  client
  vendor
}

enum EventStatus {
  prospect
  contracted
  planning
  completed
  cancelled
}

enum MilestoneStatus {
  pending
  paid
  overdue
}

enum DispatchStatus {
  assigned
  confirmed
  completed
}

enum DocumentStatus {
  pending
  signed
}

enum InvoiceStatus {
  submitted
  paid
  rejected
}

enum ComplianceKind {
  w9
  coi
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  name         String
  createdAt    DateTime @default(now()) @map("created_at")

  events        Event[]
  vendor        Vendor?
  refreshTokens RefreshToken[]

  @@map("users")
}

model Event {
  id                 String      @id @default(uuid())
  clientId           String      @map("client_id")
  eventName          String      @map("event_name")
  eventDate          DateTime    @map("event_date")
  status             EventStatus @default(prospect)
  totalContractPrice Decimal     @map("total_contract_price") @db.Decimal(12, 2)
  venue              String?
  phase              String      @default("Design Approval")
  runSheet           String?     @map("run_sheet")
  surveyDueAt        DateTime?   @map("survey_due_at")
  crewDebriefAt      DateTime?   @map("crew_debrief_at")
  crewDebriefNotes   String?     @map("crew_debrief_notes")

  client      User               @relation(fields: [clientId], references: [id])
  milestones  Milestone[]
  assignments EventAssignment[]
  documents   Document[]
  invoices    Invoice[]
  surveys     SurveyResponse[]

  @@map("events")
}

model Milestone {
  id            String          @id @default(uuid())
  eventId       String          @map("event_id")
  milestoneName String          @map("milestone_name")
  percentage    Decimal         @db.Decimal(5, 2)
  amount        Decimal         @db.Decimal(12, 2)
  status        MilestoneStatus @default(pending)
  dueDate                 DateTime        @map("due_date")
  stripeCheckoutSessionId String?         @unique @map("stripe_checkout_session_id")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("milestones")
}

model Vendor {
  id          String  @id @default(uuid())
  userId      String  @unique @map("user_id")
  companyName String  @map("company_name")
  serviceType String  @map("service_type")
  coiVerified Boolean @default(false) @map("coi_verified")
  w9OnFile      Boolean   @default(false) @map("w9_on_file")
  slaSignedAt   DateTime? @map("sla_signed_at")
  slaSignedName String?   @map("sla_signed_name")

  user         User               @relation(fields: [userId], references: [id])
  assignments  EventAssignment[]
  invoices     Invoice[]
  compliance   ComplianceFile[]

  @@map("vendors")
}

model EventAssignment {
  id             String         @id @default(uuid())
  eventId        String         @map("event_id")
  vendorId       String         @map("vendor_id")
  loadInWindow   DateTime?      @map("load_in_window")
  dispatchStatus DispatchStatus @default(assigned) @map("dispatch_status")
  zoneNotes      String?        @map("zone_notes")
  cueNotes       String?        @map("cue_notes")

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([eventId, vendorId])
  @@map("event_assignments")
}

model Document {
  id         String         @id @default(uuid())
  eventId    String         @map("event_id")
  title      String
  body       String
  status     DocumentStatus @default(pending)
  signedName String?        @map("signed_name")
  signedAt   DateTime?      @map("signed_at")
  signerIp   String?        @map("signer_ip")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model Invoice {
  id          String        @id @default(uuid())
  vendorId    String        @map("vendor_id")
  eventId     String        @map("event_id")
  amount      Decimal       @db.Decimal(12, 2)
  notes       String?
  status      InvoiceStatus @default(submitted)
  submittedAt DateTime      @default(now()) @map("submitted_at")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model ComplianceFile {
  id         String         @id @default(uuid())
  vendorId   String         @map("vendor_id")
  kind       ComplianceKind
  fileName   String         @map("file_name")
  storedPath String         @map("stored_path")
  uploadedAt DateTime       @default(now()) @map("uploaded_at")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("compliance_files")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Inquiry {
  id         String   @id @default(uuid())
  firstName  String   @map("first_name")
  lastName   String   @map("last_name")
  email      String
  phone      String?
  eventType  String?  @map("event_type")
  eventDate  String?  @map("event_date")
  guestCount String?  @map("guest_count")
  budget     String?
  services   String?
  details    String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("inquiries")
}

model SurveyResponse {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  rating    Int
  comments  String?
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("survey_responses")
}

model OutboxEmail {
  id        String    @id @default(uuid())
  toEmail   String    @map("to_email")
  subject   String
  body      String
  sentAt    DateTime? @map("sent_at")
  sentVia   String?   @map("sent_via")
  error     String?
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("outbox_emails")
}
