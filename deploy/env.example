# Production secrets for the GMKtec host.
# Path: /home/ernest/projects/active/fused-productions/.env
# deploy-production.sh keeps these keys and only updates FUSED_IMAGE.

FUSED_IMAGE=ghcr.io/tiptophimp/fused-productions:replace-with-sha

POSTGRES_USER=fused
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=fused
DATABASE_URL=postgresql://fused:change-this-db-password@fusedproductions-db:5432/fused
JWT_SECRET=replace-with-at-least-32-characters-secret

SITE_URL=https://fusedproductions.com
NEXT_PUBLIC_SITE_URL=https://fusedproductions.com

FUSED_DEMO_PAYMENTS=0

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

RESEND_API_KEY=
MAIL_FROM=Fused Productions <support@fusedproductions.com>

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Fused Productions <support@fusedproductions.com>
SMTP_URL=

RUN_MIGRATIONS=1
