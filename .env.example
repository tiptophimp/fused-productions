# Copy to `.env` in this repo for local, or to
# /home/ernest/projects/active/fused-productions/.env on the GMKtec host.
# Never commit the filled file.

# --- required for portals ---
DATABASE_URL=postgresql://fused:fused@localhost:5433/fused
JWT_SECRET=replace-with-at-least-32-characters-secret

# Runtime public URL (used by Stripe success links + invite emails).
# Prefer SITE_URL in production so it is not baked into the Docker image.
SITE_URL=http://localhost:3010
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# Local seed only
SEED_PASSWORD=changeme-local-only

# Leave 1 locally. Set 0 in production once Stripe keys are in.
FUSED_DEMO_PAYMENTS=1

# --- Stripe Checkout (optional until you go live) ---
# Dashboard → Developers → API keys (secret key, starts with sk_)
STRIPE_SECRET_KEY=
# Dashboard → Developers → Webhooks → Add endpoint
# URL: https://fusedproductions.com/api/stripe/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=

# --- Mail (optional; without these, invites stay in admin outbox + mailto) ---
# Option A: Resend
RESEND_API_KEY=
MAIL_FROM=Fused Productions <support@fusedproductions.com>

# Option B: SMTP
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Fused Productions <support@fusedproductions.com>

# Production container: run prisma migrate deploy on boot
RUN_MIGRATIONS=1
